/QqoTjrpKRDMfGFPYpgIaTmHkbQ6Lk-brN77OxCYwl0jTtluavivXDdd4lR2wQsr_hcIggw=s68-w68-h68-c-k-c0x00ffffff-no-nd-rj","width":68,"height":68},{"url":"https://yt3.ggpht.com/QqoTjrpKRDMfGFPYpgIaTmHkbQ6Lk-brN77OxCYwl0jTtluavivXDdd4lR2wQsr_hcIggw=s136-w136-h136-c-k-c0x00ffffff-no-nd-rj","width":136,"height":136}]},"title":{"runs":[{"text":"Gaming"}]},"callToAction":{"runs":[{"text":"Browse all gaming"}]},"callToActionIcon":{"iconType":"CHEVRON_RIGHT"},"endpoint":{"clickTrackingParams":"CLYCEIq6BBgBIhMIsZW59OvShQMVcFt6BR1tZgh4","commandMetadata":{"webCommandMetadata":{"url":"/gaming","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCOpNcN46UbXVtpKMrmU4Abg"}},"trackingParams":"CLYCEIq6BBgBIhMIsZW59OvShQMVcFt6BR1tZgh4"}}],"trackingParams":"CLUCEN2tBBiKASITCLGVufTr0oUDFXBbegUdbWYIeA=="}}],"collapsedItemCount":1,"trackingParams":"CLACEM2rARgBIhMIsZW59OvShQMVcFt6BR1tZgh4"}},"showMoreText":{"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"trackingParams":"CLACEM2rARgBIhMIsZW59OvShQMVcFt6BR1tZgh4","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CLACEM2rARgBIhMIsZW59OvShQMVcFt6BR1tZgh4","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CLACEM2rARgBIhMIsZW59OvShQMVcFt6BR1tZgh4","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CLACEM2rARgBIhMIsZW59OvShQMVcFt6BR1tZgh4","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CLACEM2rARgBIhMIsZW59OvShQMVcFt6BR1tZgh4","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"Absolutely unbelievable. I even had a -8 golf with An Eagle! \n\nWelcome to the adrenaline-fueled world of GTA V speedrunning with the legendary DarkViperAU! In each thrilling installment of \"How The Speedrun Ended,\" we're serving up a rollercoaster ride of gameplay highlights, gut-busting funny moments, and epic fails.\n\nJoin me as I relentlessly explore the vast terrain of Los Santos, unearthing new strategies, exploiting bugs, and uncovering those elusive glitches in a quest to conquer the GTA V speedrunning leaderboards. We're talking about the main categories, folks: Any%, 100%, Classic%, Trevor%, and Any% NMS. I've been the reigning champion in these categories for ages, so expect nothing less than world-record-worthy gameplay.\n\nBut here's the twist – these episodes aren't just about showcasing my victories; they're a peek behind the curtain at my spectacular failures and my not-so-serious attempts to keep you entertained. Laughter is guaranteed as I navigate the chaos of Los Santos, all while chasing those coveted world records.\n\nIf you're a speedrunning enthusiast, GTA V fanatic, or just in the mood for some gaming hilarity, you've come to the right place. Subscribe, hit that notification bell, and join us on this wild journey through the unpredictable world of GTA V speedrunning. Share this video with your fellow gamers, and let's explore the highs, lows, and everything in between together! \n\n✔Twitch Channel ~   / darkviperau  \n✔Rambles Podcast ~    / @viperrambles  \n✔VOD Channel ~    / @darkviperaulivestreams  \n✔Shorts Channel ~    / @darkviperaushorts416  \n✔My Discord ~   / discord  \n✔Subreddit ~   / darkviperau  \n✔Twitter ~   / darkviperau  \n✔Instagram ~   / darkviperau  \n✔TikTok ~   / darkviperau  \n✔Facebook ~  / 61554548326574  \n✔GTA 5 Speedrun Discord ~   / discord  \n✔Business Email ~ darkviperau@mgmtexe.com\n✔Merch ~ https://darkviperau-merch.myspreadsho...\n✔YouTube Membership ~ https://www.youtube.com/darkviperau/join\n\nCheck out YouTube Keyword Search, a tool that allows you to find clips by searching YouTube subtitles~    • This New Tool Will Change YouTube (Or...  \n\nMade in collaboration with Roberta \u0026 Gustavo \n\nMusic by Chillhop: http://chillhop.com/listen\nComplete content ID Playlist: https://spoti.fi/2Kjlacd\nListen on Spotify: http://bit.ly/ChillhopSpotify\n\n#gta5 #speedrun #gaming","commandRuns":[{"startIndex":1440,"length":17,"onTap":{"innertubeCommand":{"clickTrackingParams":"CLACEM2rARgBIhMIsZW59OvShQMVcFt6BR1tZgh4SNrGiqLpiPzIiQE=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqa0VpWGlQdUdXS0MtTWV6Sy12ZTRzbkJNNG4yQXxBQ3Jtc0ttNTgyUmJMdno3WWY2QUpacnZPWUFiSFBZTm11WkYwd3NuV1pBS2RMV2I1bW9Uc0RRWWc4U1FqYjVNQWhyNXE1RUlSQUM3cHFpVm1QSFQ5aV8yc0x3RkdXVWExSnhOb2xoOVVfWjEteW04cVkyeW5CVQ\u0026q=https%3A%2F%2Fwww.twitch.tv%2FDarkViperAU\u0026v=iZHwRpRCo1o","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqa0VpWGlQdUdXS0MtTWV6Sy12ZTRzbkJNNG4yQXxBQ3Jtc0ttNTgyUmJMdno3WWY2QUpacnZPWUFiSFBZTm11WkYwd3NuV1pBS2RMV2I1bW9Uc0RRWWc4U1FqYjVNQWhyNXE1RUlSQUM3cHFpVm1QSFQ5aV8yc0x3RkdXVWExSnhOb2xoOVVfWjEteW04cVkyeW5CVQ\u0026q=https%3A%2F%2Fwww.twitch.tv%2FDarkViperAU\u0026v=iZHwRpRCo1o","target":"TARGET_NEW_WINDOW","nofollow":true}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"Twitch Channel Link: DarkViperAU"}}},{"startIndex":1477,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CLACEM2rARgBIhMIsZW59OvShQMVcFt6BR1tZgh4","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/@ViperRambles","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/@ViperRambles","nofollow":true}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: @ViperRambles"}}},{"startIndex":1513,"length":30,"onTap":{"innertubeCommand":{"clickTrackingParams":"CLACEM2rARgBIhMIsZW59OvShQMVcFt6BR1tZgh4","commandMetadata":{"webCommandM