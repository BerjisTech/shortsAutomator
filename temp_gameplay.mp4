TY_HIDDEN"}},{"clickTrackingParams":"CDUQ8FsiEwixlbn069KFAxVwW3oFHW1mCHg=","updateToggleButtonStateCommand":{"toggled":false,"buttonId":"TOGGLE_BUTTON_ID_TYPE_STRUCTURED_DESCRIPTION"}}]}}}},"trackingParams":"CB0Q040EGAQiEwixlbn069KFAxVwW3oFHW1mCHg="}},"content":{"structuredDescriptionContentRenderer":{"items":[{"videoDescriptionHeaderRenderer":{"title":{"runs":[{"text":"An Amazing Run Dies Spectacularly - How The Speedrun Ended (GTA V) - "},{"text":"#105","navigationEndpoint":{"clickTrackingParams":"CDQQ1soDGJEBIhMIsZW59OvShQMVcFt6BR1tZgh4","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/105","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUHCgMxMDUYAQ%3D%3D"}},"loggingDirectives":{"trackingParams":"CDQQ1soDGJEBIhMIsZW59OvShQMVcFt6BR1tZgh4","visibility":{"types":"12"},"enableDisplayloggerExperiment":true}}]},"channel":{"simpleText":"DarkViperAU"},"views":{"simpleText":"203,975 views"},"publishDate":{"simpleText":"21 Oct 2019"},"factoid":[{"factoidRenderer":{"value":{"simpleText":"7.6K"},"label":{"simpleText":"Likes"},"accessibilityText":"7.6K likes"}},{"factoidRenderer":{"value":{"simpleText":"203,975"},"label":{"simpleText":"Views"},"accessibilityText":"203,975 views"}},{"factoidRenderer":{"value":{"simpleText":"2019"},"label":{"simpleText":"21 Oct"},"accessibilityText":"21 Oct 2019"}}],"channelNavigationEndpoint":{"clickTrackingParams":"CB0Q040EGAQiEwixlbn069KFAxVwW3oFHW1mCHg=","commandMetadata":{"webCommandMetadata":{"url":"/@DarkViperAU","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCV6mNrW8CrmWtcxWfQXy11g","canonicalBaseUrl":"/@DarkViperAU"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_k5f6kBcKhgT93zhr3y3OLZXQTZu2lwmjyVOClfbMYPato=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"simpleText":"Show more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Absolutely unbelievable. I even had a -8 golf with An Eagle! \n\nWelcome to the adrenaline-fueled world of GTA V speedrunning with the legendary DarkViperAU! In each thrilling installment of \"How The Speedrun Ended,\" we're serving up a rollercoaster ride of gameplay highlights, gut-busting funny moments, and epic fails.\n\nJoin me as I relentlessly explore the vast terrain of Los Santos, unearthing new strategies, exploiting bugs, and uncovering those elusive glitches in a quest to conquer the GTA V speedrunning leaderboards. We're talking about the main categories, folks: Any%, 100%, Classic%, Trevor%, and Any% NMS. I've been the reigning champion in these categories for ages, so expect nothing less than world-record-worthy gameplay.\n\nBut here's the twist – these episodes aren't just about showcasing my victories; they're a peek behind the curtain at my spectacular failures and my not-so-serious attempts to keep you entertained. Laughter is guaranteed as I navigate the chaos of Los Santos, all while chasing those coveted world records.\n\nIf you're a speedrunning enthusiast, GTA V fanatic, or just in the mood for some gaming hilarity, you've come to the right place. Subscribe, hit that notification bell, and join us on this wild journey through the unpredictable world of GTA V speedrunning. Share this video with your fellow gamers, and let's explore the highs, lows, and everything in between together! \n\n✔Twitch Channel ~   / darkviperau  \n✔Rambles Podcast ~    / @viperrambles  \n✔VOD Channel ~    / @darkviperaulivestreams  \n✔Shorts Channel ~    / @darkviperaushorts416  \n✔My Discord ~   / discord  \n✔Subreddit ~   / darkviperau  \n✔Twitter ~   / darkviperau  \n✔Instagram ~   / darkviperau  \n✔TikTok ~   / darkviperau  \n✔Facebook ~  / 61554548326574  \n✔GTA 5 Speedrun Discord ~   / discord  \n✔Business Email ~ darkviperau@mgmtexe.com\n✔Merch ~ https://darkviperau-merch.myspreadsho...\n✔YouTube